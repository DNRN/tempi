{
  "name": "tempi",
  "version": "0.0.0",
  "description": "An AI harness built on the pi agent for co-creating playable games",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "tempi": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:local-mcp": "TEMPI_LOCAL_MCP=1 vitest run src/e2e-local-mcp.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "pi-subagents": "0.88.0",
    "pi-web-access": "0.47.0",
    "playwright": "1.65.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
